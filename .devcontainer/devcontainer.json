{
  "name": "Tumblekin",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "npm install",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Tumblekin",
      "onAutoForward": "openBrowser",
      "protocol": "http",
      "requireLocalPort": false
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
