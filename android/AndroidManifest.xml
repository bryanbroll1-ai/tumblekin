<?xml version="1.0" encoding="utf-8"?>
<!-- Android-Test-App: eine WebView um die Browser-Fassung (browser/dist).
     Versionsnummer und -name setzt build-apk.sh beim Bauen. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.tumblekin.test">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- Die App selbst lädt nichts aus dem Netz. Die WebView bekommt die
         Berechtigung trotzdem, damit https-Adressen und Links nach draussen
         nicht schon an ihr scheitern. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- navigator.vibrate() für das Rütteln bei Treffern. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Tumblekin"
        android:hardwareAccelerated="true"
        android:allowBackup="false">

        <!-- configChanges: Drehen, Tastatur und Schriftgrösse starten die
             Activity nicht neu — sonst lädt die Seite neu und die Partie ist weg. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
